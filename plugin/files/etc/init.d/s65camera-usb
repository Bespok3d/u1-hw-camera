#!/bin/sh

BESPOK3D=/userdata/bespok3d
PLUGIN=$BESPOK3D/usr/local/plugins/camera-hw-accel
BIN=$PLUGIN/bin
CTRL_BIN=$BESPOK3D/usr/local/plugins/camera-controls/bin
RUN=$BESPOK3D/run
DEVICE="${2:-/dev/video18}"
DEV_ID="$(echo "$DEVICE" | sed 's|/dev/||')"

CMD_FAKE_SERVICE="$BIN/fake-service"
CMD_FAKE_SERVICE_ARGS="--retry 3"

CMD_CAPTURE="$BIN/capture-v4l2-jpeg-mpp --device $DEVICE --jpeg-sock /tmp/capture-${DEV_ID}-jpeg.sock --mjpeg-sock /tmp/capture-${DEV_ID}-mjpeg.sock --h264-sock /tmp/capture-${DEV_ID}-h264.sock"

CMD_WEBRTC="$BIN/stream-webrtc --h264-sock /tmp/capture-${DEV_ID}-h264.sock --webrtc-sock /tmp/capture-${DEV_ID}-webrtc.sock"

start() {
    if [ ! -e "$DEVICE" ]; then
        echo "USB camera $DEVICE not found, not starting."
        return
    fi

    umask 0022

    printf "Starting capture-usb (%s): " "$DEV_ID"
    start-stop-daemon -S -b -q -m -p $RUN/capture-${DEV_ID}-mpp.pid \
        -x $CMD_FAKE_SERVICE -- $CMD_FAKE_SERVICE_ARGS $CMD_CAPTURE
    echo "OK"

    printf "Waiting for capture-usb (%s) to deliver a frame: " "$DEV_ID"
    if /usr/bin/python3 "$BIN/wait-for-frame.py" "/tmp/capture-${DEV_ID}-jpeg.sock"; then
        echo "OK"
    else
        echo "TIMEOUT (camera may not stream)"
    fi

    printf "Starting stream-webrtc-usb (%s): " "$DEV_ID"
    start-stop-daemon -S -b -q -m -p $RUN/stream-${DEV_ID}-webrtc.pid \
        -x $CMD_FAKE_SERVICE -- $CMD_FAKE_SERVICE_ARGS $CMD_WEBRTC
    echo "OK"

    CTRL_SOCK_ARG=""
    if [ -d $BESPOK3D/usr/local/plugins/camera-controls ]; then
        printf "Starting control-v4l2-usb (%s): " "$DEV_ID"
        start-stop-daemon -S -b -q -m -p $RUN/control-${DEV_ID}-v4l2.pid \
            -x /usr/bin/python3 -- "$CTRL_BIN/control-v4l2.py" \
            --device "$DEVICE" --sock /tmp/v4l2-control-${DEV_ID}.sock
        echo "OK"
        CTRL_SOCK_ARG="--control-sock /tmp/v4l2-control-${DEV_ID}.sock"
    fi

    printf "Starting stream-http-usb (%s): " "$DEV_ID"
    start-stop-daemon -S -b -q -m -p $RUN/stream-${DEV_ID}-http.pid \
        -x $CMD_FAKE_SERVICE -- $CMD_FAKE_SERVICE_ARGS \
        /usr/bin/python3 $BIN/stream-http.py \
        --jpeg-sock /tmp/capture-${DEV_ID}-jpeg.sock \
        --mjpeg-sock /tmp/capture-${DEV_ID}-mjpeg.sock \
        --h264-sock /tmp/capture-${DEV_ID}-h264.sock \
        --webrtc-sock /tmp/capture-${DEV_ID}-webrtc.sock \
        $CTRL_SOCK_ARG \
        --bind 127.0.0.1 --port 8081 \
        --html-dir $PLUGIN/html
    echo "OK"
}

stop() {
    for pair in "stream-http-usb:$RUN/stream-${DEV_ID}-http.pid" \
                "stream-webrtc-usb:$RUN/stream-${DEV_ID}-webrtc.pid" \
                "capture-usb:$RUN/capture-${DEV_ID}-mpp.pid"; do
        name="${pair%%:*}"
        pidfile="${pair##*:}"
        printf "Stopping %s (%s): " "$name" "$DEV_ID"
        start-stop-daemon -K -q -p "$pidfile" 2>/dev/null || true
        echo "OK"
    done
    if [ -d $BESPOK3D/usr/local/plugins/camera-controls ]; then
        printf "Stopping control-v4l2-usb (%s): " "$DEV_ID"
        start-stop-daemon -K -q -p $RUN/control-${DEV_ID}-v4l2.pid 2>/dev/null || true
        echo "OK"
    fi
}

status() {
    for pair in "stream-http-usb:$RUN/stream-${DEV_ID}-http.pid" \
                "control-v4l2-usb:$RUN/control-${DEV_ID}-v4l2.pid" \
                "stream-webrtc-usb:$RUN/stream-${DEV_ID}-webrtc.pid" \
                "capture-usb:$RUN/capture-${DEV_ID}-mpp.pid"; do
        name="${pair%%:*}"
        pidfile="${pair##*:}"
        if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
            echo "$name ($DEV_ID): running (pid $(cat "$pidfile"))"
        elif [ -f "$pidfile" ]; then
            echo "$name ($DEV_ID): dead (stale pidfile)"
        else
            echo "$name ($DEV_ID): stopped"
        fi
    done
}

case "$1" in
    start)          start ;;
    stop)           stop ;;
    restart|reload) stop; sleep 1; start ;;
    status)         status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status} [device]"
        exit 1
        ;;
esac

exit 0
