#!/bin/sh

BESPOK3D=/userdata/bespok3d
PLUGIN=$BESPOK3D/usr/local/plugins/camera-hw-accel
BIN=$PLUGIN/bin
CTRL_BIN=$BESPOK3D/usr/local/plugins/camera-controls/bin
STATE_FILE=$PLUGIN/camera-state.json
RUN=$BESPOK3D/run
LMDCTL=$BESPOK3D/etc/init.d/lmdctl

# User config rendered by the daemon (defaults here keep boot working before any reconfigure, and on
# an older package without camera.conf). WebRTC defaults ON: the Fluidd/Mainsail webcam tile is
# registered for the WebRTC stream, so off-by-default would blank it. Turn off only with MJPEG.
WEBRTC_ENABLED=1
CAMERA_RESOLUTION=1080p
WEBRTC_SESSION_TIMEOUT_MIN=0
[ -f "$PLUGIN/camera.conf" ] && . "$PLUGIN/camera.conf"

case "$CAMERA_RESOLUTION" in
    720p) CAM_WIDTH=1280; CAM_HEIGHT=720 ;;
    *)    CAM_WIDTH=1920; CAM_HEIGHT=1080 ;;
esac

# 0 = off (a stream lives as long as it is watched). Otherwise recycle each viewer after N minutes;
# the tile reconnects on its own, so it is a brief blip, not a freeze. Dead viewers are always reaped.
WEBRTC_SESSION_TIMEOUT_S=$((WEBRTC_SESSION_TIMEOUT_MIN * 60))

# SIGTERM crashes unisrv (std::terminate -> 210MB core, can wedge the display), so route lmd
# teardown through the jinni-owned lmdctl (SIGKILL + wait-for-gone). Fall back to a direct SIGKILL
# if lmdctl is not deployed yet (plugin updated before the jinni).
lmd_stop() {
    if [ -x "$LMDCTL" ]; then
        "$LMDCTL" stop
    else
        killall -9 unisrv lmd rkaiq_3A_ 2>/dev/null
    fi
}

lmd_verify_rearm() {
    [ -x "$LMDCTL" ] || return 0
    "$LMDCTL" rearm
    "$LMDCTL" verify
}

CMD_FAKE_SERVICE="$BIN/fake-service"
CMD_FAKE_SERVICE_ARGS="--retry 3"

CMD_CAPTURE="$BIN/capture-v4l2-raw-mpp --device /dev/video11 --format nv12 --jpeg-quality 7 --jpeg-sock /tmp/capture-mipi-jpeg.sock --mjpeg-sock /tmp/capture-mipi-mjpeg.sock --h264-sock /tmp/capture-mipi-h264.sock --raw-frame-sock /tmp/capture-mipi-raw.sock --width $CAM_WIDTH --height $CAM_HEIGHT --fps 30"

CMD_WEBRTC="$BIN/stream-webrtc --h264-sock /tmp/capture-mipi-h264.sock --webrtc-sock /tmp/capture-mipi-webrtc.sock --session-timeout-s $WEBRTC_SESSION_TIMEOUT_S"

start() {
    if [ ! -e /dev/video11 ]; then
        echo "MIPI camera /dev/video11 not found, not starting."
        return
    fi

    umask 0022
    mkdir -p /userdata/.tmp_timelapse
    chown -R lava:lava /userdata/.tmp_timelapse

    lmd_stop

    printf "Starting capture-mipi: "
    start-stop-daemon -S -b -q -m -p $RUN/capture-mipi-mpp.pid \
        -x $CMD_FAKE_SERVICE -- $CMD_FAKE_SERVICE_ARGS $CMD_CAPTURE
    echo "OK"

    printf "Waiting for capture-mipi to deliver a frame: "
    if /usr/bin/python3 "$BIN/wait-for-frame.py" /tmp/capture-mipi-jpeg.sock; then
        echo "OK"
    else
        echo "TIMEOUT (camera may not stream)"
    fi

    WEBRTC_SOCK_ARG=""
    if [ "$WEBRTC_ENABLED" = "1" ]; then
        printf "Starting stream-webrtc: "
        start-stop-daemon -S -b -q -m -p $RUN/stream-mipi-webrtc.pid \
            -x $CMD_FAKE_SERVICE -- $CMD_FAKE_SERVICE_ARGS $CMD_WEBRTC
        echo "OK"
        WEBRTC_SOCK_ARG="--webrtc-sock /tmp/capture-mipi-webrtc.sock"
    fi

    CTRL_SOCK_ARG=""
    if [ -d $BESPOK3D/usr/local/plugins/camera-controls ]; then
        printf "Starting control-v4l2: "
        start-stop-daemon -S -b -q -m -p $RUN/control-mipi-v4l2.pid \
            -x /usr/bin/python3 -- "$CTRL_BIN/control-v4l2.py" \
            --device /dev/v4l-subdev2 --sock /tmp/v4l2-control-mipi.sock \
            --state-file $STATE_FILE
        echo "OK"
        CTRL_SOCK_ARG="--control-sock /tmp/v4l2-control-mipi.sock"
    fi

    printf "Starting camera-stream: "
    start-stop-daemon -S -b -q -m -p $RUN/stream-mipi-http.pid \
        -x $CMD_FAKE_SERVICE -- $CMD_FAKE_SERVICE_ARGS \
        /usr/bin/python3 $BIN/camera-stream.py \
        --jpeg-sock /tmp/capture-mipi-jpeg.sock \
        --mjpeg-sock /tmp/capture-mipi-mjpeg.sock \
        --h264-sock /tmp/capture-mipi-h264.sock \
        $WEBRTC_SOCK_ARG \
        $CTRL_SOCK_ARG \
        --bind 127.0.0.1 --port 8080 \
        --html-dir $PLUGIN/html
    echo "OK"

    (
        export LD_PRELOAD=$BIN/libv4l2-imposter.so
        export V4L2_IMPOSTER_SOCKET_PATH=/tmp/capture-mipi-raw.sock
        export V4L2_IMPOSTER_DEVICE=/dev/video11
        export V4L2_IMPOSTER_WIDTH=1920
        export V4L2_IMPOSTER_HEIGHT=1080
        export V4L2_IMPOSTER_FORMAT=nv12
        printf "Starting lmd: "
        start-stop-daemon -S -b -q -m -p $RUN/unisrv.pid -x /usr/bin/lmd
        echo "OK"
    )

    lmd_verify_rearm
}

stop() {
    printf "Stopping lmd: "
    lmd_stop
    echo "OK"
    for pair in "stream-http:$RUN/stream-mipi-http.pid" \
                "stream-webrtc:$RUN/stream-mipi-webrtc.pid" \
                "capture-mipi:$RUN/capture-mipi-mpp.pid"; do
        name="${pair%%:*}"
        pidfile="${pair##*:}"
        printf "Stopping %s: " "$name"
        start-stop-daemon -K -q -p "$pidfile" 2>/dev/null || true
        echo "OK"
    done
    if [ -d $BESPOK3D/usr/local/plugins/camera-controls ]; then
        printf "Stopping control-v4l2: "
        start-stop-daemon -K -q -p $RUN/control-mipi-v4l2.pid 2>/dev/null || true
        echo "OK"
    fi
}

status() {
    for pair in "lmd:$RUN/unisrv.pid" \
                "stream-http:$RUN/stream-mipi-http.pid" \
                "control-v4l2:$RUN/control-mipi-v4l2.pid" \
                "stream-webrtc:$RUN/stream-mipi-webrtc.pid" \
                "capture-mipi:$RUN/capture-mipi-mpp.pid"; do
        name="${pair%%:*}"
        pidfile="${pair##*:}"
        if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
            echo "$name: running (pid $(cat "$pidfile"))"
        elif [ -f "$pidfile" ]; then
            echo "$name: dead (stale pidfile)"
        else
            echo "$name: stopped"
        fi
    done
}

case "$1" in
    start)          start ;;
    stop)           stop ;;
    restart|reload) stop; sleep 1; start ;;
    status)         status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
