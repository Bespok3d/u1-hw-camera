{
  "name": "camera-hw-accel",
  "title": "Camera HW Accel",
  "version": "0.1.10",
  "license": "GPL-3.0-only",
  "author": "bespoked",
  "description": "Tap into the SoC's video pipeline instead of CPU-encoding every frame. MJPEG over HTTP at /webcam, WebRTC at /webrtc; works on any browser, smooth 30fps even with two cameras attached.\n\nTo have these auto-registered as cameras in Fluidd and Mainsail (so you don't have to add them by hand under Settings → Cameras), also install b3d://bespok3d-org/webcam-builtin for the built-in MIPI camera and b3d://bespok3d-org/webcam-usb for the external USB camera.",
  "tagline": "HW-accelerated MJPEG and WebRTC streaming for MIPI & USB cameras.",
  "category": "camera",
  "channel": "stable",
  "printer_specific": true,
  "changelog": "doc/CHANGELOG.md",
  "published_at": "2025-08-14",
  "updated_at": "2026-07-28",
  "source": "https://github.com/bespok3d-org/plugin-camera-hw-accel",
  "publisher": "PLACEHOLDER",
  "provides": [
    {
      "service": "camera-service"
    }
  ],
  "require": [],
  "conflicts": [],
  "requires": {
    "capabilities": [
      "rockchip-mpp"
    ],
    "variables": []
  },
  "permissions": [
    "init.autostart",
    "nginx.location"
  ],
  "config": [
    {
      "key": "WEBRTC_ENABLED",
      "label": "WebRTC stream",
      "type": "toggle",
      "onValue": "1",
      "offValue": "0",
      "default": "1",
      "hint": "On by default: the Fluidd/Mainsail camera tile is registered for the WebRTC stream. Turning it off saves memory, but ONLY do so if your camera is set to the MJPEG stream, otherwise the tile goes blank.",
      "userEditable": true
    },
    {
      "key": "CAMERA_RESOLUTION",
      "label": "Built-in camera resolution",
      "type": "select",
      "options": [
        "1080p",
        "720p"
      ],
      "default": "1080p",
      "hint": "Capture resolution for the built-in (MIPI) camera. 720p uses less memory and CPU, handy on low-RAM boards. The external USB camera always uses its own native resolution.",
      "userEditable": true
    },
    {
      "key": "WEBRTC_SESSION_TIMEOUT_MIN",
      "label": "Recycle WebRTC viewers after (minutes, 0 = off)",
      "type": "number",
      "default": "0",
      "hint": "0 (recommended): a camera stays connected as long as you watch it. Set a number of minutes to periodically recycle each WebRTC viewer connection as a memory-safety backstop on a very constrained board; the tile reconnects on its own within a couple of seconds, so it no longer freezes. Dead or abandoned viewers are always cleaned up regardless of this setting.",
      "userEditable": true
    }
  ],
  "bake": [
    {
      "class": "docker-c",
      "dockerfile": "../toolchain/Dockerfile",
      "context": "..",
      "platform": "linux/arm64",
      "out": "/out",
      "members": [
        {
          "path": "capture-v4l2-raw-mpp",
          "dest": "files/bin/capture-v4l2-raw-mpp",
          "mode": "0755"
        },
        {
          "path": "capture-v4l2-jpeg-mpp",
          "dest": "files/bin/capture-v4l2-jpeg-mpp",
          "mode": "0755"
        },
        {
          "path": "stream-webrtc",
          "dest": "files/bin/stream-webrtc",
          "mode": "0755"
        },
        {
          "path": "stream-rtsp",
          "dest": "files/bin/stream-rtsp",
          "mode": "0755"
        },
        {
          "path": "camera-stream.py",
          "dest": "files/bin/camera-stream.py",
          "mode": "0755"
        },
        {
          "path": "control-v4l2.py",
          "dest": "files/bin/control-v4l2.py",
          "mode": "0755"
        },
        {
          "path": "wait-for-frame.py",
          "dest": "files/bin/wait-for-frame.py",
          "mode": "0755"
        },
        {
          "path": "fake-service",
          "dest": "files/bin/fake-service",
          "mode": "0755"
        },
        {
          "path": "libv4l2-imposter.so",
          "dest": "files/bin/libv4l2-imposter.so",
          "mode": "0755"
        }
      ]
    }
  ],
  "install": {
    "dirs": [],
    "templates": [
      {
        "from": "files/camera.conf.tmpl",
        "to": "camera.conf"
      }
    ],
    "symlinks": [
      {
        "from": "files/bin",
        "to": "$BESPOK3D/usr/local/plugins/camera-hw-accel/bin"
      },
      {
        "from": "files/html",
        "to": "$BESPOK3D/usr/local/plugins/camera-hw-accel/html"
      },
      {
        "from": "files/etc/init.d/s65camera-hw",
        "to": "$BESPOK3D/etc/init.d/autostart/s65camera-hw"
      },
      {
        "from": "files/etc/init.d/s65camera-usb",
        "to": "$BESPOK3D/etc/init.d/autostart/s65camera-usb"
      },
      {
        "from": "files/udev/99-camera-usb.rules",
        "to": "/etc/udev/rules.d/99-camera-usb.rules"
      }
    ],
    "patches": [],
    "start": [
      "$BESPOK3D/etc/init.d/autostart/s65camera-hw restart",
      "$BESPOK3D/etc/init.d/autostart/s65camera-usb restart"
    ]
  },
  "stop": [
    "$BESPOK3D/etc/init.d/autostart/s65camera-hw stop",
    "$BESPOK3D/etc/init.d/autostart/s65camera-usb stop",
    "$BESPOK3D/etc/init.d/lmdctl restart",
    "/etc/init.d/S61moonraker restart"
  ],
  "endpoints": [
    {
      "label": "Camera 1",
      "path": "/webcam/"
    },
    {
      "label": "Camera 2",
      "path": "/webcam2/"
    }
  ],
  "conflict_resolutions": [],
  "files": []
}
